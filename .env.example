# Copy to .env (or set in your host's dashboard). All values are optional locally.

# --- Database (leave DATABASE_URL empty to use a local SQLite file) ---
DATABASE_URL=
SQLITE_FILE=./data/ajaia.db
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# --- Security (required in production) ---
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7

# --- Accounts ---
ALLOW_SIGNUP=true
MIN_PASSWORD_LENGTH=8
# Demo accounts for reviewers; set SEED_DEMO_DATA=false for a real deployment.
SEED_DEMO_DATA=true
DEMO_PASSWORD=password123

# --- Limits ---
MAX_UPLOAD_MB=2
UPLOADS_PER_MINUTE=20
LOGIN_ATTEMPTS_PER_15_MIN=10
SIGNUPS_PER_HOUR_PER_IP=10
VERSION_SESSION_MINUTES=5
MAX_VERSIONS_PER_DOC=100

# --- Server ---
PORT=3001
# LOG_REQUESTS=true
